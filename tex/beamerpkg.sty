\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerpkg}[2026/09/30 v0.2 Record Beamer movie assets]

\RequirePackage{multimedia}
\RequirePackage{hyperref}

\newwrite\beamerpkgassetfile
\immediate\openout\beamerpkgassetfile=\jobname.beamerpkg-assets
\AtEndDocument{\immediate\closeout\beamerpkgassetfile}

\newcommand{\beamerpkgrecordasset}[1]{%
  \begingroup
  \edef\beamerpkgassetpath{\detokenize{#1}}%
  \immediate\write\beamerpkgassetfile{\beamerpkgassetpath}%
  \endgroup
}

% Portable standard Beamer movie annotation. In pdfpc this is click-to-play.
\newcommand{\pkgmovie}[3][]{%
  \beamerpkgrecordasset{#3}%
  \movie[#1]{#2}{#3}%
}

% pdfpc-specific launch-link movie. Options follow pdfpc's run: URL syntax,
% e.g. [autostart&loop]. Keep this separate from the portable \movie path.
\newcommand{\pkgpdfpcmovie}[3][autostart]{%
  \beamerpkgrecordasset{#3}%
  \href{run:#3?#1}{#2}%
}
